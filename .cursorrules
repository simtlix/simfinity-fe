└── examples/      # Usage examples and patterns
```

## Common Patterns

### Dynamic Field Rendering
```typescript
// Field type detection
const isNumeric = ['Int', 'Float'].includes(fieldType);
const isBoolean = fieldType === 'Boolean';
const isDate = fieldType === 'DateTime';
const isObject = !isScalarType(fieldType);
const isCollection = fieldType.startsWith('[') && fieldType.endsWith(']');
```

### Collection Management
```typescript
// Collection state management
const [addedItems, setAddedItems] = useState<any[]>([]);
const [modifiedItems, setModifiedItems] = useState<Record<string, any>>({});
const [deletedItems, setDeletedItems] = useState<string[]>([]);
```

### Form Customization
```typescript
// Field customization
const fieldConfig = formCustomization?.fields?.[fieldName];
const isVisible = fieldConfig?.visible ?? true;
const isEnabled = fieldConfig?.enabled ?? true;
```

